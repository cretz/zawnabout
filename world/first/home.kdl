}

road meadow-harbor w=10 {
    p -150 300
    p -200 550
    p -150 700
}
road meadow-hill w=10 {
    p 0 300
    p 450 450
    p 900 380
    p 1250 350
}
road meadow-plateau w=10 {
    note "Cut into the plateau's south face, climbing to the tiers."
    p -300 200 40
    p -800 50 500
    p -1150 150 450
    p -1450 260 480
    p -1950 260 0
}

// Small caves on their own

dugout fern-dugout x=-480 y=55 z=600 facing=east r=25 {
    note "Tiny cave in the valley wall near the meadow. The first secret most people find."
}
dugout tiers-cellar x=-2180 y=20 z=-100 facing=west r=30 {
    note "Below the lowest tier, just above the waves."
}
dugout loch-cave x=-1400 y=30 z=-860 facing=north r=35 {
    note "At the head of the gull loch, under the plateau cliff."
}
dugout gull-nook-1 x=-950 y=70 z=-1480 facing=north r=22
dugout gull-nook-2 x=-600 y=110 z=-1530 facing=north r=22
dugout gull-nook-3 x=-200 y=60 z=-1655 facing=north r=22
dugout gull-nook-4 x=400 y=140 z=-1625 facing=north r=22
dugout gull-nook-5 x=900 y=90 z=-1550 facing=north r=22
roost gull-cliffs {
    note "North cliff face and the loch walls. Seabirds later."
    p -1850 -1350
    p -1250 -1200
    p 1400 -1420
}

caves tarn {
    note "Isolated. A crack behind the hidden tarn."
    mouth tarn-crack kind=cliff w=24 tight=#true hidden=#true {
        p -650 445 -1110
        p -650 460 -1190
    }
    cavern tarn-cave x=-650 y=480 z=-1250 w=120 h=60 d=100 shape=dome glow=0.4
}

// The deep: the big underground system. Joined to the crescent by the deep road (world.kdl).

caves deep {
    cavern great-hall x=300 y=-700 z=-100 w=2300 h=520 d=1500 rot=-6 shape=hall glow=0.3 {
        note "As open as the sky. Bank, climb, dive between pillars. An underground city sits on the floor."
        pillar hall-pillar-1 x=-300 z=-400 r=60
        pillar hall-pillar-2 x=500 z=-550 r=80
        pillar hall-pillar-3 x=950 z=200 r=70
        pillar hall-pillar-4 x=1200 z=-300 r=50
        pillar hall-pillar-5 x=50 z=-150 r=90
        city lantern-hollow style=cavern tech=mid y=-950 {
            p -650 50
            p -100 -50
            p 250 150
            p 150 550
            p -400 500
        }
        beacon hall-beacon-1 x=-200 y=-950 z=250
        beacon hall-beacon-2 x=1000 y=-950 z=-300
    }

    cavern glass-lake x=-1550 y=-560 z=250 w=900 h=380 d=1000 rot=15 shape=dome glow=0.35 {
        note "Crystal glow off still water. The underground river leaves from the south end."
        lake glass-lake-water level=-680 {
            p -1900 0
            p -1500 -100
            p -1250 200
            p -1350 550
            p -1750 600
        }
        beacon glass-beacon x=-1850 y=-670 z=300
    }

    cavern drop-hall x=1700 y=-1050 z=1150 w=800 h=900 d=700 rot=20 shape=shaft glow=0.25 {
        note "Tall shaft. The river falls almost 800m. The deep road leaves from the bottom."
        beacon drop-beacon x=1500 y=-1490 z=1200
    }

    cavern north-vault x=0 y=-1100 z=-2300 w=2600 h=600 d=1300 rot=-8 shape=hall glow=0.25 {
        note "Under the north sea. Huge and empty, with a sea stack as its only door to the sky."
        beacon north-vault-beacon x=-400 y=-1390 z=-2250
    }

    passage west-run w=180 {
        p -800 -700 100
        p -1150 -620 200
    }
    passage river-run w=170 {
        p -1500 -680 700
        p -900 -720 950
        p 0 -730 1000
        p 800 -700 1050
        p 1350 -680 1100
    }
    river glass-river w=40 {
        p -1500 -690 700
        p -900 -695 950
        p 0 -700 1000
        p 800 -702 1050
        falls deep-falls h=775
        p 1350 -705 1100
        p 1500 -1480 1150
    }
    passage east-run w=200 {
        p 1350 -650 400
        p 1550 -680 800
    }
    passage spine-run w=200 {
        note "Down from the great hall's north end, under the sea cliffs, into the north vault."
        p 0 -750 -800
        p -150 -900 -1300
        p 0 -1050 -1700
    }

    mouth north-mouth kind=cliff w=140 light=#true {
        note "Big obvious mouth in the north sea cliff. The easy way in."
        p 200 -650 -800
        p -100 -400 -1050
        p 250 -150 -1250
        p 100 60 -1450
        p 150 90 -1680
    }
    mouth falls-door kind=waterfall w=70 hidden=#true light=#true {
        note "Behind the high falls. Light comes through the water curtain."
        p -1300 -420 0
        p -1050 -200 -100
        p -850 20 -150
        p -760 70 -150
    }
    mouth bell-sink kind=sinkhole w=90 hidden=#true light=#true {
        note "Hidden in the thick wood. A single beam of daylight into the great hall."
        p 700 600 -700
        p 680 -100 -650
        p 650 -450 -550
    }
    mouth sea-gate kind=cliff w=70 {
        note "Low in the east sea cliff, out of the drop hall."
        p 1950 -800 1100
        p 2050 -300 950
        p 1960 45 860
    }
    mouth north-stack-door kind=stack w=60 hidden=#true light=#true {
        note "Through a lone sea stack off the north coast, straight down into the north vault."
        p 600 90 -2600
        p 600 -300 -2560
        p 550 -800 -2450
    }
}

spire north-stack x=600 z=-2600 h=95 r=70 top=flat {
    note "Lone stack off the north cliffs. Hollow in the middle."
    perch north-stack-top x=640 y=95 z=-2620
}
