// Carved in stone, out where few people go.
landmark elder-faces kind=faces x=-1900 y=0 z=-5045 rot=180 {
    note "Four great faces carved into the elder isle's north cliff, looking out to sea: a dragon, an owl, a bear and an elder."
}
landmark needle-warden-oar kind=warden x=-4608 y=0 z=3420 rot=-90 text="oar" {
    note "A stone mariner with a great oar, carved out of the west face of the second needle, one of the two wardens at the needles' west gate."
}
landmark needle-warden-lamp kind=warden x=-4648 y=0 z=3850 rot=-90 text="lamp" {
    note "A stone lamplighter carved out of a needle's west face, the other warden at the west gate. The lantern burns at night."
}
landmark spine-spiral kind=faces x=-960 y=0 z=-767 rot=180 text="spiral" {
    note "A great stepped spiral cut high in the spine's south sea cliff, with three round bosses beneath. Nobody knows who made it."
}
