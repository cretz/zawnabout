postcard zoo name="The Hill Zoo" island=home x=-320 z=580 r=50 line="Elephants, giraffes, penguins and one very nosy lion."
postcard waterpark name="The Water Park" island=home x=-680 z=1420 r=50 line="Slides and pools on the side of Terrace Hill. Everyone comes home soggy and happy."
postcard museum name="The Hill Museum" island=home x=-450 z=925 r=40 line="Old things in glass cases, and a guard who knows a story about every one."
postcard theater name="The Hill Theater" island=home x=-625 z=925 r=45 line="Stone seats in a half circle. The best seats are the top row, under the sky."
postcard circuit name="The Meadow Circuit" island=home x=-1350 z=1450 r=60 line="A race track in the meadow. On race days you can hear it from the mountain."
postcard gnome-moot name="The Gnome Moot" island=home x=-2300 z=1550 r=30 line="Garden gnomes in a circle. Nobody puts them there. They just turn up."
postcard old-swing name="The Old Swing" island=home x=-2600 z=1900 r=30 line="A rope swing on a big old tree. You can see the sea from the top of the swing."
postcard churchyard name="The Meadow Churchyard" island=home x=-2250 z=420 r=40 line="A little church in the meadows, with bells that ring for every wedding."
postcard cliff-bench name="The Cliff Bench" island=home x=-3500 z=750 r=30 line="The best bench on the islands, right at the edge, facing the sunset."
postcard treehouse name="The Treehouse" island=home x=-3300 z=500 r=35 line="A treehouse in the west woods, with a rope ladder and a secret club."
postcard tiers name="Sunset Tiers" island=home x=-3925 z=700 r=60 line="A town stepped up a cliff, every window facing the sunset."
postcard kettle-market name="Kettle Market" island=home x=-1822 z=1603 r=40 line="Fish, flowers and fish pie, under striped awnings by the harbor."
postcard harbor-park name="Harbor Park" island=home x=-1300 z=1900 r=45 line="A green park by Kettle Harbor, with a pond for toy boats."
postcard lantern-hollow name="Lantern Hollow" island=home x=-1800 y=-920 z=1130 r=80 line="A town in a cave, lit by a thousand lanterns. It's never dark here."
postcard marina name="Moonharbor Marina" island=crescent x=2000 z=-1050 r=60 line="Sailboats bobbing in rows, their ropes tinkling in the wind."
postcard aquarium name="The Aquarium" island=crescent x=2250 z=-680 r=50 line="Fish in tanks as tall as houses, and an octopus who waves."
postcard university name="Moonharbor University" island=crescent x=1230 z=-1290 r=50 line="Towers and lawns and very clever people, thinking very hard."
postcard stadium name="The Moon Stadium" island=crescent x=1175 z=-1660 r=70 line="The home of the Moonharbor Moonbeams. They win sometimes."
postcard toyworks name="The Toy Works" island=crescent x=2320 z=-3400 r=50 line="Where every toy on the islands is made. It smells of paint and sawdust."
postcard beehives name="The Beehives" island=crescent x=1800 z=-3120 r=35 line="Rows of hives in the fields, humming all day long."
postcard airport name="Crescent Airport" island=crescent x=2700 z=-3250 r=80 line="Planes coming and going all day. None of them are as good at flying as you."
postcard yacht-club name="The Yacht Club" island=crescent x=3900 z=-1500 r=50 line="Very fancy boats and very fancy hats."
postcard channel-bridge name="The Channel Bridge" island=crescent x=3600 z=-1000 r=60 line="A bridge over the channel, with cars humming across it all day."
postcard north-beach name="North Beach" island=crescent x=3100 z=-3480 r=50 line="Umbrellas, sandcastles and the sound of the waves."
postcard south-key name="South Key Village" island=crescent x=4034 z=-1685 r=50 line="A quiet village at the crescent's tip, where everybody knows everybody's dog."
postcard stonehold-hall name="Stonehold Hall" island=twins x=-1902 z=-4058 r=45 line="The great hall of the old stone town, older than anyone can remember."
postcard library name="Stonehold Library" island=twins x=-1400 z=-4250 r=40 line="A library of a hundred thousand books, and one very strict librarian."
postcard tidewater-docks name="Tidewater Docks" island=twins x=0 z=-4050 r=60 line="Fishing boats, crates and gulls, everybody shouting and nobody cross."
postcard shipyard name="Tidewater Shipyard" island=twins x=-350 z=-3600 r=60 line="Ships being built, one plank at a time."
postcard balloon-field name="The Balloon Field" island=twins x=0 z=-5050 r=60 line="Hot air balloons filling up and floating off into the sky."
postcard strait-bridge name="The Strait Bridge" island=twins x=-1092 z=-4220 r=50 line="A drawbridge across the strait between the twins, lifting for the tall ships."
postcard canopy name="Canopy Village" island=fang x=2526 z=3379 r=60 line="Houses up in the trees of the rainforest, joined by rope walkways."
postcard fang-lodge name="Fang Lodge" island=fang x=4607 z=3215 r=50 line="A cozy lodge on the volcano's slopes. Hot cocoa for everyone."
postcard fang-cove name="Fang Cove" island=fang x=4394 z=2477 r=50 line="A warm little cove with a jetty and a beach of black sand."
postcard sundial name="The Great Sundial" island=fang x=3120 z=2425 r=35 line="A sundial as big as a garden. It's always right, as long as it's sunny."
postcard fang-lookout name="The Fire Lookout" island=fang x=3300 z=2600 r=35 line="A lookout tower on the volcano's flank, with a view of every island."
postcard igloo name="The Igloo" island=fang x=3900 z=3264 r=30 line="An igloo, on a volcano. Somebody has a sense of humor."
postcard palm-ring name="Palm Ring" island=atoll x=-4229 z=-3088 r=60 line="A village of huts in the palms, with the lagoon on one side and the sea on the other."
postcard surf-shack name="The Surf Shack" island=atoll x=-4430 z=-2245 r=40 line="Boards, bikes and the best waves on the islands."
postcard gull-rock name="Gull Rock" island=atoll x=-5350 z=-3050 r=30 line="A tall rock out west of the atoll, home to a very noisy gull family."
postcard oil-rig name="The Oil Rig" island=sea x=-1600 z=3100 r=50 line="A tall rig out to sea, with a helipad on top and gulls on every rail."
postcard turtle-camp name="Turtle Back" island=sea x=-1500 z=4605 r=50 line="A long low reef rock, where a castaway camps and the turtles come ashore."
postcard atoll-seals name="The Atoll Seals" island=atoll x=-4300 z=-2825 r=40 line="Seals lazing on the warm rocks inside the atoll, barking at the boats."
postcard sea-doors name="The Sea Doors" island=home x=-1158 z=-908 r=45 line="Great doors in the north sea cliff, open to the waves. Nobody remembers who built them, but everybody says hello to them."
postcard sea-doors-lake name="Behind the Sea Doors" island=home x=-1324 z=-453 r=40 line="A stair down to a still lake under the cliffs, glowing with crystals."
postcard basalt-gate name="Basalt Gate" island=fang x=4000 z=3880 r=45 line="A railway station built right into the volcano. The trains go in one side and come out in a cave."
postcard basalt-cave name="The Cave Station" island=fang x=4000 z=3245 r=35 line="The last stop, on a pillar over a warm cave lake. Mind the gap, and the drop."
find sea-doors-bell kind=bell name="The Tide Bell" x=-1256 y=4 z=-684 hint="In the long hall behind the Sea Doors, by the copper wave." story="It rings by itself at high tide. Nobody pulls the rope. There is no rope."
find basalt-clock kind=clock name="The Stationmaster's Clock" x=4012 y=3.3 z=3245 hint="At the cave station, the last stop under Basalt Gate." story="The stationmaster left it to keep time in the cave. It is always exactly right, and a little bit warm."

// More townsfolk, with favors and rides.

local wren name="Wren the Baker" town="Home Village" x=-1872 z=950 facing=200 look=2 {
    line "Fresh bread every morning! The trick is to wake up before the bread does."
    line "The village market is small, but everything in it is made with love. And flour."
    request kind=fetch ask="My bread basket blew away in the wind! It came down by the pumpkin patch, I think. Could you fetch it?" hint="Wren's bread basket came down by the pumpkin patch, east of Home Village." thanks="Still warm! Thank you, dragon. Have a coin or two, and a bun for the road." gold=10 item-kind="basket" item-name="Wren's bread basket" item-x=-1652 item-z=952
}
local gil name="Harbor Master Gil" town="Kettle Harbor" x=-1462 z=1896 facing=120 look=5 {
    line "Every boat in this harbor comes past me. Every single one. I count them twice."
    line "The Merry Puffin was my grandad's boat. She went down in a storm, but everyone swam home."
    request kind=return target="puffin-bell" ask="That bell... it's the Merry Puffin's! My grandad's ship! Would you let it come back to the harbor?" hint="Gil's grandad's ship was the Merry Puffin. Its bell is out there somewhere, near the home island's north shore." thanks="She rings just like I remember. Thank you, dragon. Take my harbor master's cap, for luck." gold=25 gift-kind="hat" gift-name="Gil's Harbor Cap" gift-story="A harbor master's cap, with a little gold anchor on the front."
}
local dot name="Dot the Florist" town="Kettle Harbor" x=-1808 z=1590 facing=270 look=1 {
    line "Roses, daisies, daffodils! Fresh this morning."
    line "The best flowers grow round the old standing stones. Nobody knows why."
    request kind=ride target="old-ring" ask="They say the wildflowers round the old standing stones are the prettiest anywhere. Would you fly me there to see?" hint="Dot wants to see the flowers round the Old Ring, the standing stones in the home island's west meadows." thanks="Oh, look at them all! I've never seen so many colors. Thank you! Here, a painting I did of my shop." gold=10 gift-kind="painting" gift-name="Dot's Flower Painting" gift-story="Every flower in Dot's shop, painted in one bright, happy jumble."
}
local bramble name="Mayor Bramble" town="Terrace Hill" x=-284 z=1170 facing=180 look=8 {
    line "Welcome to Terrace Hill! Best views, best school, best lemonade. I'm the mayor, so I'm allowed to say so."
    line "They say one end of the rainbow comes down at the very far corner of the sea. Imagine!"
    request kind=postcard target="rainbow-end" ask="Every mayor before me has wanted to know where the rainbow ends. Could you find out, and bring me a postcard?" hint="Mayor Bramble wants a postcard of the rainbow's end, in the farthest corner of the sea, past the crescent." thanks="The end of the rainbow! I'll hang it in the town hall. Here, the town's thanks, and a medal. You've earned it." gold=40 gift-kind="medal" gift-name="Mayor Bramble's Medal" gift-story="Terrace Hill's highest honor, for finding the end of the rainbow."
}
local tilly name="Tilly" town="Terrace Hill" x=-317 z=1300 facing=90 look=3 {
    line "I'm nearly eight. Eight is very old."
    line "Have you ever seen an elephant? I have. In a book."
    request kind=ride target="zoo" ask="Mum says the zoo is too far to walk. You can fly though! Can you take me to see the elephants? Please?" hint="Tilly wants a ride to the Hill Zoo, on the east side of Terrace Hill." thanks="ELEPHANTS! Real ones! Thank you thank you thank you! You can have my best shell." gold=5 gift-kind="shell" gift-name="Tilly's Best Shell" gift-story="Tilly found it on the beach and kept it in her pocket for a whole year."
}
local rosie name="Keeper Rosie" town="Terrace Hill" x=-336 z=610 facing=0 look=4 {
    line "The penguins are my favorite. Don't tell the lions."
    line "Feeding time is at three. You can watch, but please don't breathe fire on the fish."
    request kind=postcard target="atoll-seals" ask="The penguins miss the sea. Could you bring them a postcard of seals? I'll pin it up by their pool." hint="Keeper Rosie wants a postcard of seals for the penguins. There are seals on the rocks by the atoll." thanks="The penguins love it! Look at them waddle! Here, take this zoo key. Only friends get one." gold=15 gift-kind="key" gift-name="Rosie's Zoo Key" gift-story="A spare key to the zoo, for friends of the penguins."
}
local abe name="Old Fisher Abe" town="Sunset Tiers" x=-3912 z=690 facing=270 look=7 {
    line "Seventy years I've fished off these tiers. Caught a boot once. Still wear it."
    line "There's a rock far out east where the sea is always calm. I'd love to see it before I'm old."
    request kind=ride target="lone-rock" ask="Far out east there's a lone rock in the open sea. My dad fished there. Would you fly an old man out to see it?" hint="Old Fisher Abe wants to see Lone Rock, far out in the open sea east of the home island." thanks="Just as calm as Dad said. Thank you, dragon. Take my old fishing hat. It's caught a lot of sun." gold=20 gift-kind="hat" gift-name="Abe's Fishing Hat" gift-story="A floppy old fishing hat, full of hooks and memories."
}
local quill name="Professor Quill" town="Moonharbor" x=1218 z=-1308 facing=45 look=8 {
    line "I teach maps at the university. Very old maps. Some of them are wrong in interesting ways."
    line "There's a map of the elder halls somewhere. I'd give anything to see it."
    request kind=return target="elder-map" ask="Is that the Map of the Elder Halls? The real one? Oh, may the university keep it? We'd take such good care of it." hint="Professor Quill would love the Map of the Elder Halls, if it ever turns up. It was lost in the old stone island's halls." thanks="Marvelous! Simply marvelous. Here, for your hoard: the university's own compass." gold=30 gift-kind="compass" gift-name="The University Compass" gift-story="A brass compass from the university, engraved with a little moon."
}
local stella name="Captain Stella" town="Moonharbor" x=2112 z=-1312 facing=200 look=5 {
    line "I fly the seaplane. Second fastest thing on the islands. After you, I suppose."
    line "Under the lagoon there's a vault with a beacon nobody has lit in years."
    request kind=light target="crescent/vault-beacon" ask="There's an old beacon down in the vault under the lagoon. If it were lit, I could see the eye glowing from the air at night. Would you?" hint="Captain Stella wants the beacon in the vault under the crescent's lagoon lit. The eye shaft goes down to it." thanks="I saw it glowing from the cockpit last night! Thank you. Take my flying goggles. Well, my spyglass." gold=20 gift-kind="spyglass" gift-name="Stella's Spyglass" gift-story="Captain Stella used it to find landing spots on the water."
}
local benny name="Benny" town="Moonharbor" x=1402 z=-1650 facing=90 look=0 {
    line "Did you see my kickflip? No? I'll do it again. Wait. No. Wait."
    line "The stadium is right there. I wish I was on the team."
    request kind=fetch ask="I kicked my hat right over the stadium wall! It landed in there somewhere. Can you get it?" hint="Benny's hat flew into the Moon Stadium, next to the skate park." thanks="My lucky hat! Now I'll definitely land the kickflip. Here's some coins I found." gold=10 item-kind="hat" item-name="Benny's cap" item-x=1160 item-z=-1640
}
local ivy name="Nana Ivy" town="Moonharbor" x=1658 z=-1222 facing=180 look=7 {
    line "I've lived in Moonharbor ninety years. I've never been up the tower."
    line "The moon hums, you know. Dr. Orla says so, and she's very clever."
    request kind=ride target="moon-tower" ask="Would you take me to the top of the Moon Tower? I've wanted to see the whole town from up there since I was a little girl." hint="Nana Ivy wants to see the top of the Moon Tower, in the middle of Moonharbor." thanks="Oh my! There's my house! And my sister's! Thank you, dear. Have this teapot. It's older than me." gold=15 gift-kind="teapot" gift-name="Nana Ivy's Teapot" gift-story="A tiny old teapot with moons painted on it."
}
local jo name="Farmer Jo" town="South Key" x=4048 z=-1695 facing=270 look=4 {
    line "Cows, sheep, and one very opinionated goat."
    line "My cousin works at the big dam on the home island. She says it holds back a whole lake."
    request kind=postcard target="highland-dam" ask="My cousin is always on about her dam. Could you bring me a postcard of it, so I can see what all the fuss is about?" hint="Farmer Jo wants a postcard of the Highland Dam, on the home island's west plateau." thanks="That is a big dam. All right, she can talk about it a bit more. Here's a jar of coins for your trouble." gold=15
}
local penn name="Librarian Pell" town="Stonehold" x=-1386 z=-4236 facing=270 look=8 {
    line "Shh."
    line "Shh. Thank you."
    request kind=postcard target="rope-bridge" ask="I'm writing a book about bridges. Could you bring me a postcard of the rope bridge in the Needles? Quietly?" hint="Librarian Pell wants a postcard of the Rope Bridge in the Needles, far to the north west." thanks="Perfect. Very wobbly looking. Thank you. Here, a book. Please return it in three weeks." gold=10 gift-kind="book" gift-name="Pell's Book of Bridges" gift-story="A book all about bridges. It's three weeks overdue, but Pell won't mind."
}
local bram name="Smith Bram" town="Stonehold" x=-1722 z=-4130 facing=90 look=5 {
    line "Clang, clang! Horseshoes, hinges, and the odd dragon claw clipper."
    line "Stonehold's beacon used to be lit every night. Then everyone got busy."
    request kind=light target="twins/stonehold-beacon" ask="Would you light Stonehold's beacon for me? My forge is too far from it, and my arms are too short." hint="Smith Bram wants Stonehold's beacon lit, near the old town's middle." thanks="Burning bright! Thank you. Take this key. I made it myself. It doesn't open anything, but it's very shiny." gold=15 gift-kind="key" gift-name="Bram's Shiny Key" gift-story="Made by Smith Bram. It doesn't open anything. It's just shiny."
}
local ola name="Shipwright Ola" town="Tidewater" x=-345 z=-3620 facing=0 look=1 {
    line "Plank by plank. A ship is just a lot of planks that agree to float."
    line "I lost a little silver anchor in the strait, years ago. It was my first one."
    request kind=return target="strait-anchor" ask="My little silver anchor! The first one I ever made! You found it! May I have it back?" hint="Shipwright Ola lost her little silver anchor in the strait between the twins." thanks="My very first anchor. Thank you, dragon. Take this toy boat. I made it the same summer." gold=20 gift-kind="toy-boat" gift-name="Ola's Toy Boat" gift-story="The second thing Ola ever made, after the anchor. It still floats."
}
local fin name="Little Fin" town="Tidewater" x=-230 z=-4210 facing=180 look=3 {
    line "My dad's a fisherman. I'm going to be a dragon."
    line "The lighthouse is right at the end of the island. I've never been all the way."
    request kind=ride target="tidewater-light" ask="Can you fly me to the lighthouse at the end of the island? Dad says it's too far to walk with my short legs." hint="Little Fin wants a ride to Tidewater Light, at the south end of the twins." thanks="It's so tall! And so stripy! Thank you, dragon! Have my fishing medal. I won it. Sort of." gold=5 gift-kind="medal" gift-name="Fin's Fishing Medal" gift-story="For the biggest fish of the day. The fish was a boot."
}
local ash name="Ranger Ash" town="Fang Lodge" x=4590 z=3200 facing=270 look=6 {
    line "Mind the paths. The volcano's asleep, but it snores sometimes."
    line "There's a beacon up by the rim. It hasn't been lit since the last ranger retired."
    request kind=light target="fang/fang-beacon" ask="Could you light the beacon up near the rim for me? Then walkers coming down in the dark can find the lodge." hint="Ranger Ash wants the beacon on Fang lit, up near the volcano's rim." thanks="There it is! The walkers will love that. Take my lodge bell. Ring it and somebody brings cocoa." gold=20 gift-kind="bell" gift-name="Ranger Ash's Bell" gift-story="Ring it at the lodge and somebody brings you cocoa. Everywhere else, nothing happens."
}
local koa name="Chief Koa" town="Canopy" x=2540 z=3360 facing=180 look=7 {
    line "Our village lives in the trees, so the forest floor can keep its secrets."
    line "Sailors talk of a needle of rock so tall it pokes the clouds."
    request kind=postcard target="great-needle" ask="I've heard of the Great Needle all my life. Would you bring me a postcard of it, to show the children?" hint="Chief Koa wants a postcard of the Great Needle, far away to the north west." thanks="It really does poke the clouds! The children will love it. Take this flute, made by my grandmother." gold=15 gift-kind="flute" gift-name="Koa's Grandmother's Flute" gift-story="Carved from a canopy branch. It plays the sound of rain."
}
local lulu name="Lulu" town="Fang Cove" x=4380 z=2490 facing=0 look=2 {
    line "The sand here is black, and it gets ever so warm."
    line "There's a hot spring up in the crater. I've only heard about it."
    request kind=ride target="hot-spring" ask="Could you fly me up to the hot spring in the crater? My toes are cold, and I've heard it's lovely." hint="Lulu wants a ride to the Hot Spring, inside Fang's crater." thanks="Ahh, warm toes! This is wonderful. Thank you! Take this pearl. I found it on the black sand." gold=10 gift-kind="pearl" gift-name="Lulu's Black Sand Pearl" gift-story="A pearl as dark as the sand of Fang Cove."
}
local ula name="Auntie Lani" town="Palm Ring" x=-4240 z=-3070 facing=180 look=7 {
    line "Welcome to Palm Ring! Mind the coconuts."
    line "There's a bandstand on the little islet in the lagoon. They used to play every Sunday."
    request kind=ride target="bandstand" ask="I haven't been to the bandstand on the heart islet since I was a girl. Would you fly me over? It's just across the lagoon." hint="Auntie Lani wants a ride to the bandstand on the heart islet, in the middle of the atoll's lagoon." thanks="Just as I remember! I can almost hear the music. Thank you, dragon. A shell for you." gold=10 gift-kind="shell" gift-name="Auntie Lani's Shell" gift-story="Lani kept it from the last Sunday concert, sixty years ago."
}
local taro name="Diver Taro" town="Palm Ring" x=-4214 z=-3100 facing=90 look=5 {
    line "I dive the reef every day. The fish know me by name."
    line "The captain of the reef wreck had a golden goblet. I've looked for it for years."
    request kind=return target="reef-goblet" ask="The captain's goblet! I've been looking for that my whole life! Would you let me keep it in the village hall?" hint="Diver Taro is looking for the Captain's Goblet from the reef wreck on the atoll's outer reef." thanks="The whole village will see it now. Thank you, dragon! Take my diving map." gold=20 gift-kind="map" gift-name="Taro's Diving Map" gift-story="Every reef and wreck round the atoll, drawn on waterproof paper."
}
local glow name="Glow the Miner" town="Lantern Hollow" x=-1770 y=-925 z=1160 facing=0 look=6 {
    line "Down here we make our own sunshine. Lanterns, mostly."
    line "The great hall has two old beacons. One's out on the far side."
    request kind=light target="home/hall-beacon-1" ask="Could you light the old beacon at the far end of the great hall? The cave carts could do with the light." hint="Glow wants the first beacon in the great hall lit, under the home island near Lantern Hollow." thanks="Lovely! I can see the cart tracks from here now. Take this gem from the mine. I've got loads." gold=15 gift-kind="gem" gift-name="Glow's Mine Gem" gift-story="A little green gem from the deep mine, polished on Glow's sleeve."
}
local jasper name="Jasper the Painter" town="Kettle Harbor" x=-1310 z=1880 facing=200 look=6 {
    line "I paint the harbor every day. It's different every day. Sometimes it's blue."
    line "Juno and I are friendly rivals. Very friendly. Very rivals."
    request kind=postcard target="mist-falls" ask="Juno painted the High Falls. I want to paint something better: the Mist Falls on Fang! Could you bring me a postcard?" hint="Jasper wants a postcard of the Mist Falls, on the volcano island, Fang." thanks="Ha! Juno will be green with envy. Thank you! Take a painting, from my blue period." gold=10 gift-kind="painting" gift-name="Jasper's Blue Harbor" gift-story="Kettle Harbor, painted entirely in blue. Even the sun."
}
local poppy name="Poppy" town="Home Village" x=-1940 z=1135 facing=300 look=1 {
    line "I'm going to climb the mountain one day. Maybe tomorrow. Maybe the day after."
    line "Grandpa says you can see every island from the top."
    request kind=ride target="summit" ask="Can you fly me to the very top of the mountain? Grandpa says you can see every island from up there!" hint="Poppy wants a ride to the Top of Home, the highest point of the home island." thanks="I can see EVERYTHING! Grandpa was right! Thank you, dragon. You can have my kite." gold=5 gift-kind="kite" gift-name="Poppy's Kite" gift-story="A little kite with a mountain drawn on it, and a dragon flying over."
}
local finch name="Mr. Finch" town="Terrace Hill" x=-200 z=1095 facing=90 look=8 {
    line "I watch birds. Gulls, puffins, and once, a dragon. That was you, I think."
    line "The puffins nest on the gull rock out west of the atoll."
    request kind=postcard target="gull-rock" ask="I've never seen the gull colony on Gull Rock, west of the atoll. Would you bring me a postcard? I'd count every bird." hint="Mr. Finch wants a postcard of Gull Rock, far west of the atoll." thanks="Forty-seven gulls! And one puffin! Thank you. Take my old binoculars. Well, my spyglass." gold=15 gift-kind="spyglass" gift-name="Mr. Finch's Spyglass" gift-story="For watching birds. It has watched forty-seven gulls and one dragon."
}
local hazel name="Hazel" town="Stonehold" x=-1840 z=-4250 facing=200 look=2 {
    line "Stonehold has the best maze in the islands. Also the only one."
    line "I always get lost in the maze. It's very good at being a maze."
    request kind=ride target="twin-maze" ask="I've never found the middle of the hedge maze. Could you fly me in from the top? Is that cheating? I don't mind." hint="Hazel wants to see the middle of the Hedge Maze, on the old stone island." thanks="So THAT's what the middle looks like! Thank you, dragon. Have my map of the maze. I won't need it now." gold=10 gift-kind="map" gift-name="Hazel's Maze Map" gift-story="A map of the hedge maze, with a lot of crossed-out wrong turns."
}
local ollie name="Ollie" town="Moonharbor" x=1488 z=-1470 facing=180 look=0 {
    line "I'm the best kite flyer in Moonharbor. My kite just doesn't know it yet."
    line "The park is the windiest place in town. Windy is good. Mostly."
    request kind=fetch ask="My kite got stuck up on the cinema roof! Can you get it down for me?" hint="Ollie's kite is stuck on the cinema roof, by Moonharbor's park." thanks="My kite! It's not even torn! Thank you, dragon. Have my second-best kite too. No wait. My third-best." gold=5 gift-kind="kite" gift-name="Ollie's Third-Best Kite" gift-story="It flies, mostly sideways. Ollie says that's on purpose." item-kind="kite" item-name="Ollie's kite" item-x=1552 item-z=-1478
}

// Other dragons, one on each outer island. Each leads the way to a secret of its own.
find cinder-scale kind=gem name="Cinder's Old Scale" x=-1888 z=-5035 story="A scale as big as a dinner plate, shed by Grandmother Cinder long ago. It still feels warm."
find blaze-ribbon kind=ribbon name="Blaze's First Ribbon" x=3603 z=3665 story="The very first ribbon Blaze ever won, hidden by the falls so nobody could win it back."
find wisp-shell kind=shell name="Wisp's Wishing Shell" x=-3700 z=4050 story="Wisp kept this by the old wreck. Hold it to your ear and it hums a little dragon song."
find tinker-key kind=key name="Tinker's Spare Key" x=3108 z=-3470 story="It opens nothing at all, Tinker says. That's what makes it so special."

dragon cinder name="Grandmother Cinder" kind=wise island=twins x=-1950 z=-4660 tint="9AB4F2" size=1.35 meet="Hrrm? Oh! Another dragon! I haven't seen one of us in a hundred years. Come and sit, little one. I'm Cinder." rumor="My grandad swears an old blue dragon sits up on the Elder Summit on the Twins, watching the sea. Nobody's been brave enough to say hello." about="The oldest dragon on the islands. She knows every story, and where most things are hidden." secret=cinder-scale gift-kind=book gift-name="Cinder's Book of Old Tales" gift-story="Stories of the dragons who flew here long ago, in Cinder's own big, curly writing." {
    perch x=-1900 z=-5045
    perch x=-2100 z=-4150
    way x=-2100 z=-4150
    way x=-1092 z=-4220
    way x=-1900 z=-5045
    line "When I was young, the islands had a dragon on every peak. Now there's you. That's a fine start."
    line "The people here are kind. They still leave their lamps lit for us, you know. Just in case."
    line "Sit a while. The view from up here never gets old. Neither do I, apparently."
}
dragon blaze name="Blaze" kind=racer island=fang x=3600 z=3000 tint="FF9A6A" size=1.05 meet="Whoa, a new dragon! Bet you can't keep up with me. I'm Blaze, the fastest thing on four wings. Well, two wings. You know what I mean." rumor="Something orange goes whooshing round the rim of the old volcano on Fang most days. Folk say it's a dragon who loves a race." about="A show-off who loves racing. Fast, loud and very friendly." secret=blaze-ribbon gift-kind=trophy gift-name="Blaze's Spare Trophy" gift-story="Blaze has so many trophies there's no room in the nook. This one's for you, for being a good sport." race-to="Fang Lodge" race-x=4607 race-z=3215 race-r=60 prize-kind=medal prize-name="The Fang Lodge Medal" prize-story="You beat Blaze to Fang Lodge! Blaze says it was the wind. It wasn't the wind." {
    perch x=3300 z=2600
    perch x=3450 z=3150
    way x=3450 z=3150
    way x=3603 z=3665
    line "I flew round the whole island before breakfast. Twice. I think. It was very fast."
    line "Watch this! No, wait, you missed it. I'll do it again later."
    line "Racing is the best. Second best is talking about racing."
}
dragon wisp name="Wisp" kind=shy island=needles x=-4300 y=330 z=3600 tint="C8A8F5" size=0.8 meet="Oh! You kept coming back. I'm... I'm Wisp. Sorry I flew off. You seem nice." rumor="The fishermen say a little purple dragon hides on top of the Needles. Shy thing. Flies off if you get close, but it always peeks back." about="A shy young dragon who lives on the Needle tops. Flies off at first, but stays once it trusts you." secret=wisp-shell gift-kind=shell gift-name="Wisp's Pretty Pebble Shell" gift-story="Wisp left this by your heap without a word. Very shy. Very sweet." {
    perch x=-4560 y=220 z=3420
    perch x=-3920 y=250 z=3680
    way x=-4579 y=200 z=3878
    way x=-3700 z=4050
    line "The Needles are quiet. I like quiet. And you. You're quiet too, mostly."
    line "Sometimes I watch the ships from up here and pretend they're all going somewhere nice."
    line "Do you want to see my favorite place? I don't show anybody. Well, there's nobody to show."
}
dragon tinker name="Tinker" kind=collector island=crescent x=1550 z=-1350 tint="7FD6B0" size=1.0 meet="Hello hello! A dragon! Do you collect things too? Of course you do. I'm Tinker. I collect everything, but spyglasses most of all." rumor="There's a green dragon who sits on top of Moon Tower in Moonharbor. Collects shiny things, they say. Spyglasses most of all." about="A collector of shiny and curious things, spyglasses most of all. Always happy to trade, never sad if you say no." secret=tinker-key gift-kind=clock gift-name="Tinker's Ticking Clock" gift-story="It ticks backwards on Tuesdays. Tinker says that's a feature." want=spyglass trade-kind=compass trade-name="Tinker's Golden Compass" trade-story="It always points to something interesting. Tinker swapped it for a spyglass, and you both think you got the better deal." {
    perch x=2200 z=-3000
    perch x=2320 z=-3400
    way x=2200 z=-3000
    way x=3020 z=-3500
    way x=3100 z=-3480
    line "Every shiny thing has a story. Most of them start with somebody dropping it."
    line "I keep my collection in neat little piles. Very neat. Mostly neat."
    line "Have you seen any spyglasses? I do love a spyglass. You can see other shiny things through them!"
}

// Happenings: one is always on somewhere, until you have been to see it. Then, once you
// are well away, the next begins.
happening kettle-regatta name="The Kettle Regatta" place="Kettle Harbor" x=-1316 z=1929 r=110 rumor="The regatta's on down at Kettle Harbor! Little boats everywhere, and fireworks after dark. Go and see!" seen="The regatta! Bunting on the quay, cheering from the shore, and the little boats bobbing past. Stay for the fireworks if it's dark." {
    bunting x1=-1342 z1=1926 h1=5 x2=-1290 z2=1926 h2=5
    bunting x1=-1342 z1=1933 h1=5 x2=-1290 z2=1933 h2=5
    folk name="Commodore Bea" x=-1320 z=1929 facing=0 look=6 line="Hold your hats! The red sail's in the lead! No, the blue! No, wait..."
    folk name="Little Sid" x=-1305 z=1930 facing=20 look=3 line="I'm going to sail in it next year. Or the year after. When my legs are longer."
    folk name="Mr. Pottle" x=-1330 z=1931 facing=340 look=8 line="Forty regattas I've watched. Never once seen a dragon at one before!"
    fireworks x=-1316 z=2000 h=80
}
happening village-wedding name="A Village Wedding" place="Home Village" x=-1984 z=1076 r=90 rumor="There's a wedding in Home Village! Everybody's invited, they say. Even dragons, I'd think." seen="A wedding! Rosie and Tom are married, and the whole village is dancing. They're so happy you came!" {
    bunting x1=-2000 z1=1074 h1=5 x2=-1968 z2=1074 h2=5
    lanterns x1=-2000 z1=1079 h1=6 x2=-1968 z2=1079 h2=6
    folk name="Rosie" x=-1986 z=1076 facing=90 look=1 line="We're married! And a dragon came to the wedding! Nobody's ever going to believe this."
    folk name="Tom" x=-1982 z=1076 facing=270 look=0 line="I was so nervous I forgot my own name. Rosie had to remind me. It's Tom."
    folk name="Auntie Gwen" x=-1975 z=1074 facing=200 look=7 line="I cried all the way through. Happy crying! The best kind."
    fireworks x=-1984 z=1104 h=70
}
happening stonehold-market name="Market Day" place="Stonehold" x=-1827 z=-4256 r=90 rumor="It's market day up in Stonehold. Cheese, honey, wool socks, the lot. Smells wonderful." seen="Market day in Stonehold! Stalls of cheese and honey and woolly socks, and everybody haggling cheerfully." {
    bunting x1=-1842 z1=-4258 h1=5 x2=-1812 z2=-4258 h2=5
    lanterns x1=-1842 z1=-4252 h1=6 x2=-1812 z2=-4252 h2=6
    folk name="Cheesy Pete" x=-1835 z=-4256 facing=0 look=5 line="Finest cheese on the Twins! Try some. Go on. A big bite, you're a dragon."
    folk name="Honey Nell" x=-1822 z=-4256 facing=0 look=2 line="Fresh honey! The bees worked very hard. Please don't tell them I'm selling it."
    folk name="Old Ham" x=-1828 z=-4253 facing=180 look=8 line="I've come every market day for sixty years. I still never know what I came for."
}
happening moon-fireworks name="Fireworks Night" place="Moonharbor" x=1608 z=-1309 r=120 rumor="Fireworks night in Moonharbor! Best seen after dark, from up high. Which I suppose you can do." seen="Fireworks night! The whole city is out on the waterfront, waiting for dark. Find a good perch and watch the sky." {
    lanterns x1=1595 z1=-1312 h1=6 x2=1622 z2=-1306 h2=6
    folk name="Professor Wick" x=1606 z=-1309 facing=20 look=8 line="Each one is a little chemistry experiment that goes BOOM. My favorite kind."
    folk name="Juniper" x=1614 z=-1306 facing=40 look=1 line="The blue ones are the best. No, the gold ones. All of them!"
    fireworks x=1650 z=-1240 h=110
    fireworks x=1560 z=-1250 h=95
}
happening ship-launch name="A Ship Launch" place="Tidewater" x=-355 z=-3630 r=110 rumor="They're launching a new ship at the Tidewater shipyard! Flags and cheering and everything." seen="A new ship slides into the sea, and the whole shipyard cheers! The shipwrights wave at you." {
    bunting x1=-370 z1=-3630 h1=6 x2=-340 z2=-3630 h2=6
    folk name="Shipwright Odo" x=-356 z=-3628 facing=0 look=6 line="Three years building her. Now she's off to see the world. I'm not crying, it's sawdust."
    folk name="Mayor Pell" x=-347 z=-3633 facing=330 look=7 line="I name this ship... oh, I've forgotten. Somebody write it down next time."
    fireworks x=-355 z=-3560 h=60
}
happening palm-party name="A Beach Party" place="Palm Ring" x=-4241 z=-3057 r=100 rumor="There's a beach party on Palm Ring tonight. Lanterns on the sand and dancing till late!" seen="A beach party! Lanterns on the sand, music, and everyone dancing barefoot. They've saved you a spot." {
    lanterns x1=-4256 z1=-3058 h1=5 x2=-4226 z2=-3058 h2=5
    lanterns x1=-4256 z1=-3053 h1=5 x2=-4226 z2=-3053 h2=5
    folk name="Kai" x=-4244 z=-3056 facing=90 look=0 line="Dance with us, dragon! Mind the lanterns. And the sandcastles. And Grandma."
    folk name="Grandma Moana" x=-4236 z=-3056 facing=270 look=7 line="I've danced at every beach party for eighty years. I'm only just warming up."
    fireworks x=-4241 z=-3120 h=60
}
happening geese-south name="Geese Heading South" place="the bay south of Kettle Harbor" x=-1000 z=2600 r=320 rumor="The geese are gathering out over the bay, south of Kettle Harbor. They fly round and round before they set off. I've always wanted to fly with them." seen="You're flying with the geese! They honk hello and make room for you at the end of the line." {
    geese x=-1000 z=2600 h=70 r=260
}
happening ghost-ship name="The Ghost Ship" place="the open sea past the Needles" x=-3500 z=4500 r=300 rumor="Fishermen say a ghost ship rides at anchor out past the Needles, but only at night. A friendly one! It glows, and somebody aboard hums sea songs." seen="The ghost ship! It glows like moonlight on the water, and its lanterns wink hello. Somewhere aboard, somebody is humming an old sea song." {
    ghostship x=-3500 z=4500 r=40
}

// Towns thank you as you help their people: at each step, something new goes up.
favor kettle-band town="Kettle Harbor" at=2 done="Kettle Harbor has hung bunting by the harbor and got the town band out to play for you. Go and hear them!" {
    bunting x1=-1377 z1=1647 h1=5 x2=-1349 z2=1647 h2=5
    folk name="Bandleader Fen" x=-1363 z=1650 facing=180 look=6 line="One, two, one two three! This tune is called The Dragon's Jig. We wrote it this morning."
    folk name="Drummer Bo" x=-1357 z=1650 facing=200 look=3 line="Boom, boom, crash! Sorry. I get excited."
}
favor kettle-vane town="Kettle Harbor" at=5 done="Kettle Harbor put a golden dragon weather vane up in your honor! It turns with the wind, just like you." {
    vane x=-1315 z=1684 h=9
}
favor terrace-band town="Terrace Hill" at=2 done="Terrace Hill has strung up bunting and lanterns, just for you. They're very proud of their dragon." {
    bunting x1=-284 z1=1263 h1=5 x2=-256 z2=1263 h2=5
    lanterns x1=-284 z1=1268 h1=6 x2=-256 z2=1268 h2=6
}
favor terrace-vane town="Terrace Hill" at=5 done="Terrace Hill put up a golden dragon weather vane on the hill. You can see it from all over town." {
    vane x=-315 z=1282 h=10
}
favor moon-band town="Moonharbor" at=2 done="Moonharbor hung bunting along the square and a street fiddler plays for you. Go and listen!" {
    bunting x1=1556 z1=-1376 h1=5 x2=1584 z2=-1376 h2=5
    folk name="Street Fiddler Lu" x=1570 z=-1373 facing=180 look=2 line="I only know happy songs. Sad ones make my fiddle squeak."
}
favor moon-vane town="Moonharbor" at=6 done="Moonharbor put a golden dragon weather vane up by the waterfront. The city's own dragon!" {
    vane x=1608 z=-1387 h=10
}
favor tide-band town="Tidewater" at=2 done="Tidewater hung bunting on the waterfront for you, and the fishermen wave whenever you pass." {
    bunting x1=-274 z1=-3986 h1=5 x2=-246 z2=-3986 h2=5
}
