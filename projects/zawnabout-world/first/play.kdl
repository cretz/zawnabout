// Night lights: six little things that only come out after dark, glowing softly where
// they lie. Find them all and Lantern Hollow lights up for a night festival.
// Five singing things tucked away in hidden caves. Each one rings like wind chimes
// until it is found, so they are found by ear: follow the sound, louder and to one side.
set rock-songs name="Songs in the rock" done="All five singing things are found! Stonehold's musicians have learned every one of their songs, and they're playing them in the market square. Go and listen." {
    lanterns x1=-1842 z1=-4264 h1=6 x2=-1812 z2=-4264 h2=6
    folk name="Fiddler Bram" x=-1832 z=-4262 facing=180 look=6 line="Five songs from five caves! This one's from the tarn. It goes round and round like a whirlpool."
    folk name="Piper Wren" x=-1822 z=-4262 facing=180 look=1 line="I play the harp's song on my pipe. It's harder than it sounds. Well, it sounds lovely, so it's very hard."
}
find song-tarn kind=bell set=rock-songs sound="chimes" name="The Tarn Bell" x=-2450 y=462 z=-360 hint="High on the home island, a little bell rings in the rock by the crater tarn. Listen for it." story="A silver bell no bigger than a thimble. It rings by itself whenever the wind finds its way in."
find song-gull kind=harp set=rock-songs sound="chimes" name="The Gull Nook Harp" x=-2400 y=125 z=-715 hint="In a gull cave high in the home island's north cliffs, a little harp plays to itself. Listen for it." story="Its strings are thin as spider silk. The breeze through the nook plays it better than any harpist."
find song-hollow kind=music-box set=rock-songs sound="chimes" name="The Hollow Music Box" x=-4450 y=38 z=4050 hint="Inside one of the Needles, in a hollow room, a music box is still playing. Listen for it." story="Wound up a hundred years ago and it has never run down. Nobody knows the name of the tune."
find song-fang kind=bell set=rock-songs sound="chimes" name="The Glass Bell" x=3400 y=190 z=2585 hint="In one of the little nooks along Fang's north cliffs, a glass bell chimes. Listen for it." story="Clear as an icicle and just as cold. Its note makes the gulls stop and listen."
find song-strait kind=shell set=rock-songs sound="chimes" name="The Singing Shell" x=-1900 y=150 z=-4720 hint="Inside the elder twin, in the old stone hall, a shell sings to the ruins. Listen for it." story="Hold it to your ear and it sings, not the sea, but a little tune. The sea taught it."

set night-lights name="Night lights" done="All six night lights are found! Lantern Hollow is having a night festival, with lanterns strung all through the hollow. Go and see after dark." {
    lanterns x1=-1778 z1=1149 h1=6 x2=-1750 z2=1149 h2=6
    lanterns x1=-1778 z1=1155 h1=6 x2=-1750 z2=1155 h2=6
    folk name="Lamplighter Lil" x=-1764 z=1152 facing=180 look=4 line="Every night light, home again! The hollow hasn't glowed like this since my granny was small."
}
find firefly-jar kind=lantern set=night-lights when="night" name="The Firefly Jar" x=-2296 z=1560 hint="Where the garden gnomes meet in a circle, a little jar of light waits for dark." story="A jar of fireflies that never fly away. They blink hello when you pick it up."
find moonstone kind=gem set=night-lights when="night" name="The Moonstone" x=-1718 z=-410 hint="Up beside the snowman at the very top of home, a stone that only shines by moonlight." story="It glows like a little moon, and is cold as snow even on a warm night."
find star-candle kind=candle set=night-lights when="night" name="The Star Candle" x=3646 z=3030 hint="By the observatory on Fang, where people look at the stars, a candle lights itself at night." story="A candle that lit itself the night a shooting star went over. It has never gone out."
find owl-flute kind=flute set=night-lights when="night" name="The Owl's Flute" x=-2094 z=-4140 hint="In the hedge maze on the Twins, an owl's flute plays only after dark." story="Blow it softly and every owl on the islands hoots back."
find glow-shell kind=shell set=night-lights when="night" name="The Glow Shell" x=3030 z=-3490 hint="By the great sandcastle on the Crescent, a shell glows on the sand once the sun is down." story="It glows blue in the dark, like a piece of the sea at night."
find night-pearl kind=pearl set=night-lights when="night" name="The Night Pearl" x=-4250 z=3610 hint="At the foot of the Great Needle, a pearl shines up from the rocks at night." story="A pearl as dark as the night sky, with a little star twinkling inside."
