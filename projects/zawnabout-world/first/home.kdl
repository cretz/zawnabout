    note "Punts up and down the still reach of the glass river."
    p -650 -818.3 975
    p -300 -818.3 995
    p 0 -818.3 1000
    p 300 -818.3 1020
    p 600 -818.3 1040
}

// Life underground: Lantern Hollow's market, and cavers' camps out on the cavern floors.
landmark hollow-market kind=market x=0 y=-940 z=330 rot=10 {
    note "Lantern Hollow's market, busy at every hour under the lanterns."
}
landmark hall-camp kind=campsite x=900 y=-940 z=-100 rot=30 {
    note "Cavers' camp out on the great hall floor, by the old columns."
}
landmark vault-camp kind=campsite x=150 y=-1300 z=-2180 rot=-20 {
    note "An expedition camp among the ruins of the north vault."
}
landmark glass-camp kind=campsite x=-1250 y=-670 z=620 rot=60 {
    note "Cavers camped by the glass lake, where the river leaves it."
}

landmark hollow-farm kind=shroomfarm x=520 y=-940 z=120 rot=10 {
    note "Lantern Hollow's mushroom farm, at the edge of town."
}
landmark hollow-cafe kind=cafe x=-250 y=-940 z=180 rot=200 {
    note "A cafe in Lantern Hollow, lit up under the strings of lights."
}
landmark glass-mine kind=mine x=-1620 y=-660 z=-160 rot=170 {
    note "A crystal mine in the glass lake's north wall."
}
landmark glass-cafe kind=cafe x=-1330 y=-668 z=555 rot=200 {
    note "A lakeside cafe where the punts come in."
}

landmark meadow-circuit kind=racetrack x=450 z=650 rot=0 {
    note "A motor racing oval on the south meadow. Land on a car and take a few laps."
}

// The tarn's hydro scheme: a weir across the outlet above the falls, two penstocks down
// the cliff beside them, and the power house at the foot.
landmark tarn-weir kind=weir x=-760 y=427 z=-840 rot=-45 {
    note "The weir that holds the tarn, sluice gates and all. The falls pour over its spillway."
}
landmark tarn-penstock kind=penstock x=-762 y=449 z=-782 rot=-121 text="63 188" {
    note "Two pipes down the cliff from the tarn to the power house."
}
landmark tarn-hydro kind=hydro x=-805 y=261 z=-708 rot=-121 {
    note "The power house at the foot of the falls. Its turbines hum."
}

// The power line from the tarn's power house down over the plateau and the meadow to the
