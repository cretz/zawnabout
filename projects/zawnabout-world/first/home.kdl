    cavern sea-doors-front x=625 y=79 z=-1661 w=192 h=158 d=57 rot=20 shape=block glow=0 decor=bare
    cavern sea-doors-hall x=564 y=46 z=-1495 w=68 h=90 d=355 rot=20 shape=block glow=0.6 decor=bare
    cavern sea-doors-back x=501 y=54 z=-1321 w=192 h=200 d=45 rot=20 shape=block glow=0 decor=bare
    cavern sea-doors-cave x=451 y=50 z=-1183 w=400 h=250 d=320 rot=20 shape=dome glow=0.35 decor=crystal {
        note "Behind the Sea Doors. Still water under the stair, crystal glow."
