}
mountain hearthpeak x=200 z=-1200 h=820 r=420 shape=crag stretch=1.6 rot=-10 {
    note "Highest point on home. Visible from everywhere on the island."
    beacon summit-beacon x=200 z=-1200
    perch summit-perch x=240 z=-1180
}

// A tall crag on the east cliffs. The sea gate cave opens low in its seaward face.
mountain gate-head x=2000 z=620 h=150 r=200 shape=crag stretch=1.4 rot=70

// The hidden tarn sits in a cirque of crags on the spine. Only seen from above.
mountain tarn-crags x=-650 z=-950 h=520 r=320 shape=crater rim=520 inner=200 floor=445 stretch=1.3 rot=25
