// Boat tours underground: lantern-lit punts round the glass lake, and up and down the
// still reach of the glass river under the glowworms.
route glass-punts kind=punt {
    note "Punts round the glass lake under the crystals. Land on one and drift round."
    p -1750 -680 80
    p -1520 -680 20
    p -1360 -680 220
    p -1420 -680 480
    p -1700 -680 520
    p -1820 -680 300
    p -1750 -680 80
}
